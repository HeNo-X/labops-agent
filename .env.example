# ============================================================================
#  LabOps Agent 环境变量模板
#  复制为 .env 后按部署环境填写；.env 已被 .gitignore 忽略，不要提交到仓库。
#  所有变量都有安全默认值，留空即使用默认值。
# ============================================================================

# ---------------------------------------------------------------------------
#  服务端
# ---------------------------------------------------------------------------
PORT=8787
# 监听地址。默认仅本机；移动端联调可临时设为 0.0.0.0。
HOST=127.0.0.1
LOG_LEVEL=info
# SQLite 持久化路径（目录需仅服务账号可读写）。默认 server/data/labops.sqlite。
# LABOPS_DB_PATH=/absolute/persistent/path/labops.sqlite
# HTTPS 部署设 1；本地 http 设 0。
LABOPS_SECURE_COOKIE=0

# ---------------------------------------------------------------------------
#  数据源
# ---------------------------------------------------------------------------
# 默认读取 seed/snapshot.json（脱敏教学快照）；文件缺失时使用 seed/fallback-demo.json（内置示例）。
# LIVE_DATA=1 时改为读取 LABOPS_LIVE_STATE 指向的 state.json（仅本地/校内使用）。
LIVE_DATA=
LABOPS_LIVE_STATE=

# ---------------------------------------------------------------------------
#  上游实验室系统与身份
# ---------------------------------------------------------------------------
# 主系统根地址；留空则只使用沙盒数据，不连接上游。
LABOPS_BUSINESS_URL=
# native = 复用主系统账号与权限；demo = 隔离沙盒（三个本地角色）。
LABOPS_AUTH_MODE=native
# 浏览器可访问的主系统公网入口（容器内网地址与浏览器地址不同时填写）。
LABOPS_MAIN_PUBLIC_URL=
# 逗号分隔的跨源名单；默认同源。
LABOPS_ALLOWED_ORIGINS=
# 桌面 / 移动安装版允许的来源。
CLIENT_ALLOWED_ORIGINS=https://qzapp.localhost,https://tauri.localhost,https://localhost

# 沙盒默认角色（admin / volunteer / student），仅 LABOPS_AUTH_MODE=demo 时生效。
LABOPS_SANDBOX_ROLE=admin

# 委托会话凭据加密（二选一）：
#   1) 注入 32 字节随机密钥的 base64；
#   2) 留空则自动生成 0600 密钥文件，可用 LABOPS_CREDENTIAL_KEY_FILE 指定位置。
LABOPS_CREDENTIAL_KEY=
LABOPS_CREDENTIAL_KEY_FILE=

# ---------------------------------------------------------------------------
#  模型提供方
# ---------------------------------------------------------------------------
# 工作模式（任务链）主模型：Agnes。
AGNES_API_KEY=
AGNES_MODEL=agnes-3.0-flash
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_TIMEOUT_MS=45000
AGNES_MAX_RETRIES=2
AGNES_MAX_TOKENS=2000
AGNES_TEMPERATURE=0.3
AGNES_ENABLE_THINKING=0

# 聊天模式主链：阿里云百炼（OpenAI 兼容）。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODELS=qwen3.8-flash,qwen3.8-max-0902,deepseek-v4.1-flash,deepseek-v4.1-flash-1017,kimi-k3

# 备用链：智谱 BigModel（两模式共用）。
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-4.7-flash

# 备用链：讯飞星火 MaaS（一个 Key，两个模型）。
XFYUN_API_KEY=
XFYUN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_TASK_MODEL=spark-x2.6
XFYUN_CHAT_MODEL=spark-x2.6-4b

# 工作模式模型顺序，逗号分隔；默认 qwen,spark,glm,agnes。
TASK_CHAIN_ORDER=qwen,spark,glm,agnes

# ---------------------------------------------------------------------------
#  Agent 运行时
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_WALL_CLOCK_MS=120000
# 确定性链编排（故障联合处置 / 调课 / 钥匙借还）；设 0 回退纯模型链。
AGENT_CHAIN_ORCHESTRATION=1
# 只读预取（签到+值班、开放+进出、钥匙+课表）；设 0 回退纯模型链。
AGENT_READONLY_COMPOSITION=1
# 跨会话并发闸门；设 0 关闭。
AGENT_CONCURRENCY_GATE=1
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_QUEUE_WAIT_MS=30000
# 单程短路（一次工具调用直接成稿）；默认关闭，设 1 开启。
AGENT_SINGLE_PASS=0
# 答案归属：render = 事实块直接作答；model = 模型基于证据成稿。
ANSWER_GENERATION=render

# 上下文预算（确定性截断）
CONTEXT_TRIM_ENABLED=1
CONTEXT_WINDOW=65536
CONTEXT_OUTPUT_RESERVE_TOKENS=8192
CONTEXT_BREAKER_AFTER=3
# 上下文线索（上一轮日期/房间等）；设 0 关闭。
CONTEXT_HINTS=1

# 模型熔断
LLM_CIRCUIT_ENABLED=1
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLLOFF_MS=20000
LLM_CIRCUIT_MAX_COOLLOFF_MS=300000

# ---------------------------------------------------------------------------
#  知识库（RAG）
# ---------------------------------------------------------------------------
# 语料较小时默认全量注入；设 0 改用三路检索 + 可选重排。
KNOWLEDGE_FULL_INJECT=1
EMBEDDING_ENABLED=0
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
RERANK_LLM=0

# ---------------------------------------------------------------------------
#  语音输入（ASR）
# ---------------------------------------------------------------------------
# 默认走阿里云百炼 qwen3-asr-flash，并复用 DASHSCOPE_API_KEY。
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=qwen3-asr-flash
ASR_PROTOCOL=chat_audio
ASR_TIMEOUT_MS=30000
ASR_CONTEXT_ENABLED=0
ASR_CONTEXT_MAX_CHARS=1200
ASR_LANGUAGE=zh
ASR_ENABLE_ITN=0
ASR_HOTWORDS=1
ASR_HOTWORDS_MAX=500
# 原生协议（dashscope_native）才使用：
# ASR_NATIVE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# ASR_NATIVE_SAMPLE_RATE=
# 术语纠错（默认开）：按房间号/班级/课程/术语表做确定性纠正。
ASR_TERM_CORRECT=1
# 每账号每小时转写次数上限。
LABOPS_TRANSCRIBE_PER_HOUR=60

# ---------------------------------------------------------------------------
#  视觉边缘接入
# ---------------------------------------------------------------------------
# 与上报端一致的 HMAC 密钥；留空则 /api/vision/report 返回 503。
VISION_INGEST_SECRET=
# 同机 / 同内网的 MJPEG 实时画面地址。
VISION_LIVE_FEED_URL=http://127.0.0.1:5000/live/video_feed
VISION_LIVE_TOKEN=
# 监控模块开关：本地留空即启用；服务器部署可设 off。
VISION_MODULE=
# 多模态证据图像（可选；默认复用 DASHSCOPE_API_KEY）
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max-latest
VISION_TIMEOUT_MS=30000
VISION_MAX_IMAGES=3
VISION_MAX_IMAGE_BYTES=3145728

# ---------------------------------------------------------------------------
#  限流与服务调用
# ---------------------------------------------------------------------------
LABOPS_NEW_SESSIONS_PER_HOUR=60
LABOPS_RUNS_PER_MINUTE=12
LABOPS_RUNS_PER_DAY=100
LABOPS_GLOBAL_RUNS_PER_DAY=1000
# 主系统定时任务调用本服务时使用；两端必须一致。留空则通道关闭。
LABOPS_SERVICE_SECRET=
# MCP 服务默认角色（student / volunteer / admin）。
LABOPS_MCP_ROLE=student
