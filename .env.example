# ============================================================================
#  LabOps Agent 环境变量模板
#  复制为 .env 后填写。.env 已被 .gitignore 忽略，绝不入库。
# ============================================================================

# ---------------------------------------------------------------------------
#  Agnes 3.0 Flash —— 产品运行时模型（LabOps 的推理引擎）
#  ⚠️ 只在服务端读取。浏览器永远拿不到这个 Key。
#  留空 = 进入【演示引擎】模式（规则解析，不调用大模型），界面会明确标注。
#  填了但调用失败 = 显示真实错误，不会静默退回演示引擎。
#
#  接口事实（已核对官方文档 agnes-ai.com/zh-Hans/docs/agnes-30-flash）：
#    Base URL          https://api.agnes-ai.cn/v1
#    Chat Completions  POST /v1/chat/completions（OpenAI 兼容）
#    模型名称          agnes-3.0-flash
#    支持 stream / tools / tool_choice / chat_template_kwargs.enable_thinking
#    上下文 512K，最大输出 65,536 Token
# ---------------------------------------------------------------------------
AGNES_API_KEY=
AGNES_MODEL=agnes-3.0-flash
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# ---------------------------------------------------------------------------
#  服务端
# ---------------------------------------------------------------------------
PORT=8787

# 监听地址。默认 127.0.0.1 = 只有本机能访问。
# ⚠️ 不要随便改成 0.0.0.0：这个 API 会把请求转发给 Agnes，配上 Key 之后
#    监听全网就等于把 Key 的消费能力开放给整个局域网。
#    要在手机上调试移动端布局时才临时改成 0.0.0.0（然后用完改回）。
HOST=127.0.0.1

# ---------------------------------------------------------------------------
#  数据源（三选一，决定界面上的「数据来源」标识）
#    （默认，全部留空）  脱敏快照  → seed/snapshot.json
#    LIVE_DATA=1        实时数据  → 直接读 LABOPS_LIVE_STATE 指向的真实 state.json
#    （快照文件缺失）    模拟演示  → seed/fallback-demo.json
#
#  ⚠️ LIVE_DATA=1 只应在本地/校内演示时使用，且该 state.json 已被 .gitignore 排除。
# ---------------------------------------------------------------------------
LIVE_DATA=
LABOPS_LIVE_STATE=

# ---------------------------------------------------------------------------
#  ops.v1 业务沙盒（阶段 2B）—— 报修/停用/通知/值班/日报的执行环境
# ---------------------------------------------------------------------------
# 沙盒默认演示身份（admin / volunteer / student）。前端可在沙盒内切换演示视角，
# 能力边界由服务端按角色校验；未连接时办理卡只写沙盒；连接原账号后使用对话内原系统任务卡办理。
LABOPS_SANDBOX_ROLE=admin

# ---------------------------------------------------------------------------
#  有界自主与容错（§C5 / §C4）—— 都有安全默认值，改这里即可
# ---------------------------------------------------------------------------
# 单次任务最多几步（工具调用 + 收尾），硬上限
AGENT_MAX_STEPS=6
# 单次任务墙钟上限（毫秒），到点强制收敛
AGENT_WALL_CLOCK_MS=60000
# 调用 Agnes 的单次超时（毫秒）
AGNES_TIMEOUT_MS=45000
# Agnes 失败重试次数（不含首次）
AGNES_MAX_RETRIES=2
# 输出 token 上限
AGNES_MAX_TOKENS=800
# 采样温度（低温度抑制发散，与老系统实测口径一致）
AGNES_TEMPERATURE=0.3
# 是否开启 Thinking 模式（第一阶段关闭：思考过程不展示给用户，且会挤占正文预算）
AGNES_ENABLE_THINKING=0

# ---------------------------------------------------------------------------
#  可观测（§Phase 4）
# ---------------------------------------------------------------------------
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 原系统业务工作台（真实身份与原系统写入独立于演示沙盒）
# 两端都升级后填写原系统根地址，例如 https://lab.example.edu:8443
# 本地可用 http://127.0.0.1:8080，Docker 同网络可用 http://lab:8080。
LABOPS_BUSINESS_URL=
# 正常部署复用主系统账号密码与权限；demo 仅用于显式隔离测试。
LABOPS_AUTH_MODE=native
# HTTPS部署设1；localhost演示设0。
LABOPS_SECURE_COOKIE=0
# 持久化 SQLite 路径（目录必须仅服务账号可读写）
# LABOPS_DB_PATH=/absolute/persistent/path/labops.sqlite
LABOPS_NEW_SESSIONS_PER_HOUR=60
LABOPS_RUNS_PER_MINUTE=12
LABOPS_RUNS_PER_DAY=100
LABOPS_GLOBAL_RUNS_PER_DAY=1000
# 逗号分隔的显式跨源名单；默认同源，无需填写。
LABOPS_ALLOWED_ORIGINS=
# Windows / Android 安装版专用来源，与上面的网页来源配置分开。
# Compose 中同名配置优先；不需要修改原有 LABOPS_ALLOWED_ORIGINS 空值。
CLIENT_ALLOWED_ORIGINS=https://qzapp.localhost,https://tauri.localhost,https://localhost

# 0.3.0 委托会话凭证加密（二选一）
# 外部密钥管理可注入32字节随机密钥的base64；不要写入仓库、日志或前端。
LABOPS_CREDENTIAL_KEY=
# 未配置上项时，加载/首次自动生成0600密钥文件。
# 指定外部持久化位置；默认 LABOPS_DB_PATH + .key，未设DB路径时为server/credentials/business.key。
# 必须单独备份密钥；丢失会导致已保存连接无法解密，需要重新连接。
LABOPS_CREDENTIAL_KEY_FILE=

# ---------------------------------------------------------------------------
#  模型分流（2026-10-05 按负责人要求）
#    聊天模式 → DashScope（阿里云百炼）；任务模式（工作模式）→ Agnes
#    优点：聊天走国产多家模型链，任一不可用自动换下一个；任务模式固定用 Agnes。
# ---------------------------------------------------------------------------
# 阿里云百炼 Key（与上面 AGNES_API_KEY 是两套）。留空 = 聊天模式回落规则引擎。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 聊天模式的模型链，**按顺序 fallback**（前面的不可用就换下一个）
# 顺序口径：负责人给的界面列表是自上而下，要求从下往上调用 → 这里按"最先调用"排在最前。
# 2026-10-31：上一批 6 个模型免费额度全部耗尽（403 FreeTierOnly），换成下面这 5 个（均已实调通过）。
# 截图自上而下：deepseek-v4.1-flash-1017 / deepseek-v4.1-flash / qwen3.8-max-0902 / qwen3.8-flash / kimi-k3
# 仍是自下而上，唯一例外：kimi-k3 挪到最后（不认 temperature、23~32 秒、不调工具，见 server/config.ts 注释）
DASHSCOPE_MODELS=qwen3.8-flash,qwen3.8-max-0902,deepseek-v4.1-flash,deepseek-v4.1-flash-1017,kimi-k3

# ---------------------------------------------------------------------------
# 备用模型链（2026-10-31 按负责人要求新增）——主链全挂时才用
#
#   聊天模式链：DashScope 五模型 → BigModel(glm-4.7-flash) → 星火(spark-x2.6-4b)
#   工作模式链：Agnes → 星火(spark-x2.6) → BigModel(glm-4.7-flash) → 星火(spark-x2.6-4b)
#
#   · 星火那两个模型是**同一个 Key**（XFYUN_API_KEY 填一次即可）。
#   · 任一 Key 留空 → 该提供方不进链，不会被当成"可用模型"空转。
#   · 三个备用都必须是 OpenAI 兼容端点；不通就整条备用链跳过，主链行为不变。
# ---------------------------------------------------------------------------
# 智谱 BigModel（两模式共用备用）
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-4.7-flash
# 讯飞星火 MaaS（工作模式第一备用 + 两模式末位备用；一个 Key 两个模型）
XFYUN_API_KEY=
XFYUN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
XFYUN_TASK_MODEL=spark-x2.6
XFYUN_CHAT_MODEL=spark-x2.6-4b

# 主系统面向浏览器的公开入口（容器内 LABOPS_BUSINESS_URL=http://lab:8080 时必须另填）。
# 账户设置按当前身份跳转本人资料/密码表单；不在地址中传递凭证。
LABOPS_MAIN_PUBLIC_URL=https://lab.example.edu:8443

# ---------------------------------------------------------------------------
#  语音输入（ASR）—— 前端录音 → POST /api/agent/transcribe → 这里配置的模型
#    【默认已指向阿里云百炼 qwen3-asr-flash，且自动回落复用 DASHSCOPE_API_KEY】
#    —— 只要聊天链的 DASHSCOPE_API_KEY 已配置，语音识别即开箱可用，无需额外填任何内容。
#    想换供应商时用 ASR_* 覆盖（互不影响聊天链）：
#    · SiliconFlow（免费档 SenseVoice，大陆直连）
#        ASR_BASE_URL=https://api.siliconflow.cn/v1
#        ASR_MODEL=FunAudioLLM/SenseVoiceSmall
#        ASR_PROTOCOL=transcriptions
#    · Groq（whisper-turbo 免费档大方，大陆需代理）
#        ASR_BASE_URL=https://api.groq.com/openai/v1
#        ASR_MODEL=whisper-large-v3-turbo
#        ASR_PROTOCOL=transcriptions
#    · 阿里百炼（默认；与 DASHSCOPE_API_KEY 同 Key，控制台需开通 ASR 模型权限）
#        ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#        ASR_MODEL=qwen3-asr-flash
#        ASR_PROTOCOL=chat_audio
# ---------------------------------------------------------------------------
# 以下均可留空——留空即按上述默认回落（Key 复用 DASHSCOPE_API_KEY）。
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=qwen3-asr-flash
ASR_PROTOCOL=chat_audio
ASR_TIMEOUT_MS=30000
# 每账号每小时转写次数上限（防长按误触烧光上游免费额度）
LABOPS_TRANSCRIBE_PER_HOUR=60
# 专有名词纠错（默认开）：转写返回后，按数据集里的房间号/班级名/课程名做确定性纠正。
#   例：识别出「e三一零」「D五一七」→ 纠正为「E310」「D517」。
#   设 0 可关闭。改动了哪几处会随响应 corrections 字段回传，便于追溯。
#   说明：当前 chat_audio 协议没有热词参数，所以走本地词典而非模型热词；
#        纠错宁可不改也不改错（裸数字一律不猜、单次最多改 10 处、超限整段放弃）。
ASR_TERM_CORRECT=1

# ---------------------------------------------------------------------------
#  视觉边缘接入 —— 实验室摄像头 → 剥离身份 JSON → Agent / 移动端监控页
#    上报方（Vision识别技术/edge_client.py）用本 Secret 计算 HMAC-SHA256 签名，
#    头部 x-vision-ts / x-vision-nonce / x-vision-signature，时间窗 ±300 秒。
#    留空 = 视觉通道关闭（/api/vision/report 返回 503，前端给配置指引）。
#    契约与接线见 docs/vision-agent-integration-20261029.md；
#    本地无摄像头联调：VISION_INGEST_SECRET=xxx npm run mock:vision
# ---------------------------------------------------------------------------
VISION_INGEST_SECRET=
# 同机/同内网部署时的实时画面（MJPEG）来源；云端独立部署保持默认即可（自动降级）
VISION_LIVE_FEED_URL=http://127.0.0.1:5000/live/video_feed
# 视觉服务局域网化并开启 token 鉴权后填写
VISION_LIVE_TOKEN=

# ---------------------------------------------------------------------------
#  上下文预算 —— 确定性截断（不做 LLM 摘要压缩），可一键关闭
#    CONTEXT_TRIM_ENABLED=0 时行为与未接入前一致，只保留决策可观测
#    有效窗口 = CONTEXT_WINDOW - min(CONTEXT_OUTPUT_RESERVE_TOKENS, CONTEXT_WINDOW)
#    阈值 = 有效窗口 × 0.75；token 数为估算值，不冒充 provider 真实 usage
#    验证：多步任务完成后界面「任务完成」步骤显示估算/阈值/精简条数
# ---------------------------------------------------------------------------
CONTEXT_TRIM_ENABLED=1
CONTEXT_WINDOW=65536
CONTEXT_OUTPUT_RESERVE_TOKENS=8192
CONTEXT_BREAKER_AFTER=3

# ---- RAG 批次1：知识检索向量召回（2026-10-31）----
# 开启需同时满足：EMBEDDING_ENABLED=1 + DASHSCOPE_API_KEY + 已建索引
# （npm run knowledge:index）；任一不满足时检索自动退回关键词+BM25 两路。
# 向量化走 DashScope text-embedding（OpenAI 兼容端点，复用 DASHSCOPE_API_KEY/BASE_URL）。
EMBEDDING_ENABLED=0
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
# RAG 批次3：LLM 重排（对三路召回候选做一次模型打分；缺省关——配额敏感，失败自动回原序）
RERANK_LLM=0

# ---- 主系统调度器的服务调用（2026-10-31）----
# 定时任务"到点让 Agent 真跑一轮"用。两端必须填同一个值（主系统 lab 容器 + 本服务）。
# 留空 = 该通道整体关闭（/api/service/agent-run 直接 503）。
# 生成：openssl rand -hex 32
LABOPS_SERVICE_SECRET=
