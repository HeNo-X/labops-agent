# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 环境变量：绝不入库（AGNES_API_KEY 在这里）
.env
.env.local
.env.*.local

# 真实线上数据：绝不入库（只在本地/校内演示时使用）
server/data/live/state.json
/data/
*.live.json

# 未脱敏的中间产物
seed/*.raw.json
seed/*.unredacted.json

# 日志与临时文件
*.log
.DS_Store
Thumbs.db

# 浏览器验收截图（可重新生成，不入库；需要看时跑 npm run test:browser）
.screenshots/
server/data/*.sqlite
server/data/*.sqlite-*

# Delegated credentials: key is stored separately from SQLite, never published.
server/credentials/
*.key
.evaluation/

# 视觉边缘上报事件流水（运行时数据，不入库；快照只存内存不落盘）
server/data/vision/

.review-shots*/

# 本地备份（合并期 .pre-cloudapi.bak 等）
*.bak
