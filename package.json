{
  "name": "labops-agent",
  "version": "1.0.4.0",
  "private": true,
  "type": "module",
  "description": "个性化设置、会话首屏与移动导航优化的实验室Agent",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "seed": "node seed/make-snapshot.ts",
    "test": "node scripts/run-tests.mjs",
    "test:acceptance": "node --test tests/bridge-http.test.ts tests/stream-facts.test.ts",
    "test:browser": "node tests/review-browser.mjs",
    "test:all": "npm run check:rules && npm run build && npm test && npm run test:review-browser && npm run test:next-browser && npm run test:v4-browser && npm run test:v5-browser && npm run test:rounds-browser && npm run test:v6-browser && npm run test:v7-browser && npm run test:v8-browser",
    "sync:rules": "node scripts/sync-rules.mjs",
    "check:rules": "node scripts/sync-rules.mjs --check",
    "demo": "node scripts/run-review.mjs",
    "demo:seed": "node scripts/create-review-fixture.mjs",
    "test:review-browser": "node tests/review-browser.mjs",
    "test:legacy:acceptance": "node tests/acceptance.ts",
    "test:legacy:browser": "node tests/browser.ts",
    "test:next-browser": "node tests/next-browser.mjs",
    "eval:model": "node scripts/evaluate-model.ts",
    "test:v4-browser": "node tests/v4-browser.mjs",
    "test:v5-browser": "node tests/v5-browser.mjs",
    "test:rounds-browser": "node tests/rounds-browser.mjs",
    "eval:release": "node scripts/evaluate-release.mjs",
    "eval:retrieval": "node scripts/evaluate-retrieval.mjs",
    "test:v6-browser": "node tests/v6-browser.mjs",
    "test:v7-browser": "node tests/v7-browser.mjs",
    "test:nginx": "node tests/nginx-acceptance.mjs",
    "test:v8-browser": "node tests/v8-browser.mjs",
    "pack:audit": "python ../tools/audit-package.py",
    "pack:submit": "python ../tools/package-labops-agent.py"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
