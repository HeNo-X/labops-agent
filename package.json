{
  "name": "labops-agent",
  "version": "1.0.5.2",
  "private": true,
  "type": "module",
  "description": "面向高校实验室运维的 AI 原生 Agent：只读查询、提案式办理、人工确认后执行",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "seed": "node seed/make-snapshot.ts",
    "knowledge:index": "node scripts/knowledge-index.ts",
    "knowledge:eval": "node scripts/knowledge-eval.ts",
    "test": "node scripts/run-tests.mjs",
    "test:acceptance": "node --test tests/stream-facts.test.ts",
    "test:all": "npm run lint && npm run check:rules && npm run build && npm run analyze:bundle && npm test && npm run test:operations-page",
    "sync:rules": "node scripts/sync-rules.mjs",
    "check:rules": "node scripts/sync-rules.mjs --check",
    "mock:vision": "node scripts/mock-vision-feed.mjs",
    "eval:model": "node scripts/evaluate-model.ts",
    "eval:release": "node scripts/evaluate-release.mjs",
    "eval:retrieval": "node scripts/evaluate-retrieval.mjs",
    "eval:quality": "node scripts/evaluate-quality.mjs",
    "eval:asr": "node scripts/evaluate-asr.mjs",
    "mcp": "node server/mcp-server.ts",
    "mcp:selftest": "node server/mcp-server.ts --self-test",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "test:operations-page": "node tests/operations-page.test.mjs",
    "pack:audit": "python tools/audit-package.py",
    "pack:submit": "python tools/package-labops-agent.py",
    "check:asr-lexicon": "node scripts/check-asr-lexicon.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
