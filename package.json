{
  "name": "labops-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LabOps Agent · 实验室任务画布（第一阶段：一句话查课表）",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "seed": "node seed/make-snapshot.ts",
    "test": "node --test tests/unit.test.ts",
    "test:acceptance": "node tests/acceptance.ts",
    "test:browser": "node tests/browser.ts",
    "test:all": "npm run test && npm run test:acceptance && npm run test:browser"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
